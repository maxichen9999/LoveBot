# 🔴 PFLICHT: ohne diese Zeile startet der Server nicht (siehe Hinweis unten).
#    Die Nummer steht absichtlich NICHT mehr im Quelltext.
OWNER_NUMBER=
# Set these only in your local .env file. Never commit real credentials.
OWNER_PASSWORD=
PORT=7777
HOST=0.0.0.0
LOVEBOT_VERBOSE_LOG=0
LOVE_DEBUG_MSG=0
LOVE_DEBUG_SIGNAL_WARNINGS=0
# Only set true when a trusted reverse proxy is in front of the server.
TRUST_PROXY=false
#NODE_ENV=production

# ── Website-Härtung (siteSecurity.js) ────────────────────────────────────
# Strenge CSP mit Nonce je Antwort (Standard). 0 = Notausstieg auf
# 'unsafe-inline', falls eine Seite doch ein Inline-Skript braucht.
CSP_STRICT=1
# Minifizierte Assets nutzen, wenn sie per `npm run build` erzeugt wurden.
MINIFY=0
# API aus anderen Ursprüngen erlauben. Leer = Same-Origin (empfohlen).
# "*" = alle (wie früher) · "https://example.com" = genau dieser Ursprung.
API_CORS=
# Admin password for downloads, exports, and step-up confirmation. Empty uses OWNER_PASSWORD.
ADMIN_PASSWORD=

# ── OAuth / Social Login ───────────────────────────────────────────────
# Externe Basis-URL mit HTTPS; bei jedem Anbieter die passende Callback-URL hinterlegen:
# OAuth-App-Redirect-URI aktuell: https://maxichen.de
OAUTH_BASE_URL=https://maxichen.de
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Ticket-Benachrichtigungen per E-Mail (STRATO; Postfach-Passwort lokal eintragen).
# SMTP-Versand: contact@maxichen.de -> owner@maxichen.de
TICKET_SMTP_HOST=smtp.strato.de
TICKET_SMTP_PORT=465
TICKET_SMTP_SECURE=true
TICKET_SMTP_USER=contact@maxichen.de
TICKET_SMTP_PASS=

# 🔐 DATEI-LOGIN beim ÖFFNEN der Downloads (automatisch, kein Office nötig):
# Passwort hier eintragen = JEDE heruntergeladene Office-Datei (Brand-Datei,
# Live-Excel und jede Office-Datei in der All-in-One-ZIP) wird verschlüsselt.
# Beim Öffnen fragt Excel/Word/PowerPoint dann selbst nach dem Passwort —
# auf jedem Gerät, ohne Makro, ohne „Inhalt aktivieren“.
# Benutzername kann eine verschlüsselte Datei technisch NICHT abfragen
# (Benutzername+Passwort geht nur über das Makro-Login, siehe Schutz/).
# Voraussetzung auf dem Server: python3 + `pip install msoffcrypto-tool pycryptodome`
DATEI_LOGIN_PW=
DATEI_LOGIN_USER=Maxichen
